# 서버 포트 (기본값: 3001)
PORT=3001

# CORS 허용 프론트엔드 웹 URL (프로덕션 배포 시 필수, 예: https://sofar.croni.kr)
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Supabase 연결 (curated_playlists 관리, 관리자 기능 및 캐시 등에 사용)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 관리자 페이지 접근용 API Key (임의의 안전한 비밀 문자열 — 미설정 시 관리자 기능 차단)
ADMIN_API_KEY=your_secure_admin_api_key_here

# (선택) Supabase Custom Auth Email Hook 사용 시 SMTP 계정 설정
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password

# Last.fm API Key (차트 후보·추천의 '비슷한 곡'에 사용)
LASTFM_API_KEY=your_lastfm_api_key

# 추천 A/B 비율 (사용자별 고정 배정). v1=고정 가중치, v2=밴딧, v3=밴딧+학습 가중치(학습 모델이 없으면 v2로 동작)
REC_AB_SPLIT=v1:20,v2:40,v3:40

# 추천 가중치 자동 학습 (하루 한 번). 끄려면 false
REC_LTR_AUTO_TRAIN=true
