# Node modules & dependencies
node_modules/
**/node_modules/
.pnpm-store/
apps/**/package-lock.json
packages/**/package-lock.json

# Environment variables & secrets (CRITICAL: NEVER COMMIT REAL KEYS)
.env
.env.*
*.env
!.env.example
!.env*.example

# Build outputs & caches
dist/
**/dist/
build/
**/build/
.turbo/
**/.turbo/
.cache/
**/.cache/
*.tsbuildinfo

# OS & IDE junk
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
.agents/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local runtime data & caches (API store)
apps/api/data/*.json
!apps/api/data/.gitkeep


