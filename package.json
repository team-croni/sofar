{
  "name": "sofar",
  "version": "1.0.0",
  "private": true,
  "author": "Croni <https://github.com/team-croni>",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/team-croni/sofar.git"
  },
  "homepage": "https://github.com/team-croni/sofar#readme",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@sofar/web",
